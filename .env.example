# Copia este archivo como `.env.local` y rellena el token.
# `.env.local` está en .gitignore: nunca se sube a GitHub.

# Token de acceso personal (fine-grained) con permiso Contents: read-only.
# Lo usa `npm run sync` para leer tus repositorios, incluidos los privados.
# En GitHub Actions no se usa este archivo: allí el token vive en el secreto
# del repositorio, también llamado GH_PAT.
GH_PAT=

# URL pública del sitio, para sitemap y enlaces absolutos.
# En Vercel se detecta sola; en local no hace falta tocarla.
# NEXT_PUBLIC_SITE_URL=https://tudominio.vercel.app
